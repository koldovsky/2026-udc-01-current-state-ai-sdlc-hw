{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./app/node_modules/**)",
      "Read(./app/.next/**)",
      "Read(./app/out/**)",
      "Read(./app/build/**)",
      "Read(./app/package-lock.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(./app/node_modules/**)"
    ]
  }
}
